{
  "info": {
    "_postman_id": "b4e64543-77c6-4a16-9617-e5cf6798dcbd",
    "name": "Task Management API",
    "description": "Register or login first. Postman keeps the JWT cookie in its cookie jar. Creating a task automatically saves its ID for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "response": []
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weekend User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.task?._id) {",
                  "  pm.collectionVariables.set('taskId', response.task._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Finish weekend assignment\",\n  \"description\": \"Review the API and responsive task screens\",\n  \"priority\": \"high\",\n  \"status\": \"pending\",\n  \"dueDate\": \"2030-12-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/tasks"
          },
          "response": []
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks?page=1&limit=10&sort=newest"
          },
          "response": []
        },
        {
          "name": "Search and Filter Tasks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks?search=assignment&priority=high&status=pending&dueDate=upcoming&sort=due-soonest&page=1&limit=10"
          },
          "response": []
        },
        {
          "name": "Task Statistics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/stats"
          },
          "response": []
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Finish and submit assignment\",\n  \"priority\": \"medium\",\n  \"status\": \"in-progress\",\n  \"dueDate\": \"2030-12-31\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "Mark Task Complete",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/tasks/{{taskId}}/complete"
          },
          "response": []
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/logout"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "email",
      "value": "weekend.user@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "weekend123",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ]
}
